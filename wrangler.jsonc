{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-content-worker",
  "main": "wrangler.js",
  // Matches the last known-good deploy (2026-08-04). The broken deploy used
  // 2024-01-01, which is not what this Worker was built against.
  "compatibility_date": "2025-09-27",

  // The static site. Without this the Worker has no pages to serve and every
  // URL falls through to its "Not found" handler — which is what took the
  // site down. See .assetsignore for what is kept out of the upload.
  // Default not_found_handling ("none") is required here: requests that do not
  // match a file fall through to the Worker script, which is how /content,
  // /auth and /contact keep working.
  "assets": {
    "directory": "./"
  },

  "kv_namespaces": [
    {
      "binding": "CONTENT_KV",
      "id": "5e5a215d5eac47e3b0119f165627aecb"
    }
  ],

  "r2_buckets": [
    {
      "binding": "CONTENT_R2",
      "bucket_name": "site-content-images"
    }
  ],

  "vars": {
    "R2_PUBLIC_BASE_URL": "https://images.westbasketball.org.au"
  }

  // ADMIN_PASSWORD and RESEND_API_KEY are secrets and persist across deploys —
  // they are deliberately not listed here.
}
